# Required: at least 32 characters. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=
# Optional: pin the Host header when serving behind a reverse proxy (comma-separated).
MCP_ALLOWED_HOSTS=
# Optional: override the default allowed lark-cli domains.
# LARK_CLI_ALLOWED_DOMAINS=docs,drive,markdown,wiki,base,sheets,contact,schema,skills,auth,doctor,api,help,whoami
# '*' allows every domain except config/profile/update; the Feishu app's scopes become the limit.
# LARK_CLI_ALLOWED_DOMAINS=*
